	"changelog": [
		{
			"id": "2026-10-17-file-upload-attachments",
			"date": "2026-10-17",
			"spartanVersion": "1.6.1",
			"type": "improvement",
			"title": "Consistent file-upload attachments",
			"description": "Seven file-upload examples now use shared attachment patterns for image previews, file details, and upload progress, with file-specific labels for removal controls and image previews."
		},
		{
			"id": "2026-10-13-attachment-components",
			"date": "2026-10-13",
			"spartanVersion": "1.6.1",
			"type": "feature",
			"title": "Attachment components",
			"description": "Explore and copy 14 attachment patterns for file metadata, image previews, grouped layouts, upload states, and interactive progress controls."
		},
		{
			"id": "2026-10-13-spartanui-1-6-1-compatibility",
			"date": "2026-10-13",
			"spartanVersion": "1.6.1",
			"type": "improvement",
			"title": "SpartanUI 1.6.1 compatibility",
			"description": "SimUI component source now targets SpartanUI 1.6.1, keeping copied components aligned with the latest supported accessibility, overlay, form-control, and interaction APIs."
		},
		{
			"id": "2026-08-11-responsive-sidebar-examples",
			"date": "2026-08-11",
			"spartanVersion": "1.3.1",
			"type": "improvement",
			"title": "Responsive sidebar examples",
			"description": "All 13 Sidebar examples now adapt more cleanly across desktop and mobile layouts, with improved navigation states, accessible controls, and a refreshed workspace-focused variant."
		},
		{
			"id": "2026-07-27-deduplicated-registry-storage",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Deduplicated registry storage",
			"description": "Registry releases now share identical source blobs, keeping future SpartanUI compatibility updates compact without removing historical versions."
		},
		{
			"id": "2026-07-27-grouped-changelog-categories",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Grouped changelog categories",
			"description": "Updates on the same date are grouped by change type, reducing repeated badges and making the timeline more compact."
		},
		{
			"id": "2026-07-27-grouped-compatibility-badges",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Grouped compatibility badges",
			"description": "Each changelog date now shows its compatible SpartanUI version once, keeping individual update rows easier to scan."
		},
		{
			"id": "2026-07-27-unified-date-timeline",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Unified date timeline",
			"description": "Product updates and automatic component-source changes now appear together under their publication date."
		},
		{
			"id": "2026-07-27-date-based-changelog",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Date-based changelog",
			"description": "SimUI changes are now tracked chronologically, independently from SpartanUI releases, while every entry still shows its compatible SpartanUI version."
		},
		{
			"id": "2026-07-27-consistent-spartanui-branding",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "fix",
			"title": "Consistent SpartanUI branding",
			"description": "User-facing labels, compatibility messages, release history, and documentation now consistently use the SpartanUI name."
		},
		{
			"id": "2026-07-27-remembered-spartanui-version",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Clean, remembered SpartanUI versions",
			"description": "SimUI remembers your selected SpartanUI version without adding it to everyday browser URLs, while copied component links still include the version for accurate sharing."
		},
		{
			"id": "2026-07-27-clearer-release-cards",
			"date": "2026-07-27",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Clearer release cards",
			"description": "Each changelog release received a distinct, responsive layout that separates curated highlights from automatic component-source changes."
		},
		{
			"id": "2026-07-26-repeatable-registry-publishing",
			"date": "2026-07-26",
			"spartanVersion": "1.1.2",
			"type": "improvement",
			"title": "Repeatable registry publishing",
			"description": "Registry snapshots can be regenerated for an existing SpartanUI version while keeping the versioned source and latest alias in sync."
		},
		{
			"id": "2026-07-26-registry-release-history",
