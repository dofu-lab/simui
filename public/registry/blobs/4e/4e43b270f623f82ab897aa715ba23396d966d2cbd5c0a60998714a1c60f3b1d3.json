	"content": "import { ChangeDetectionStrategy, Component, computed, input, signal } from '@angular/core';\nimport { FormsModule } from '@angular/forms';\nimport { RouterLink } from '@angular/router';\nimport { NgIcon, provideIcons } from '@ng-icons/core';\nimport {\n\tlucideBell,\n\tlucideBookOpen,\n\tlucideChartColumnBig,\n\tlucideChevronRight,\n\tlucideCircleDollarSign,\n\tlucideExternalLink,\n\tlucideLogOut,\n\tlucideMegaphone,\n\tlucideMessageCircle,\n\tlucideMoon,\n\tlucidePackage,\n\tlucidePlus,\n\tlucideSearch,\n\tlucideSettings,\n\tlucideStore,\n\tlucideSun,\n\tlucideUser,\n\tlucideUsers,\n} from '@ng-icons/lucide';\nimport { HlmAvatarImports } from '@spartan-ng/helm/avatar';\nimport { HlmButtonImports } from '@spartan-ng/helm/button';\nimport { HlmCollapsibleImports } from '@spartan-ng/helm/collapsible';\nimport { HlmDropdownMenuImports } from '@spartan-ng/helm/dropdown-menu';\nimport { HlmInputGroupImports } from '@spartan-ng/helm/input-group';\nimport { HlmKbdImports } from '@spartan-ng/helm/kbd';\nimport { HlmLabelImports } from '@spartan-ng/helm/label';\nimport { HlmRadioGroupImports } from '@spartan-ng/helm/radio-group';\nimport { HlmScrollAreaImports } from '@spartan-ng/helm/scroll-area';\nimport { HlmSidebarImports, HlmSidebarService, provideHlmSidebarConfig } from '@spartan-ng/helm/sidebar';\nimport { NgScrollbar } from 'ngx-scrollbar';\n\nconst SIDEBAR_ITEMS = [\n\t{\n\t\tid: 'dashboard',\n\t\ttitle: 'Dashboard',\n\t\ticon: 'lucideChartColumnBig',\n\t\titems: [\n\t\t\t{ id: 'dashboard-overview', title: 'Overview' },\n\t\t\t{ id: 'dashboard-analytics', title: 'Analytics' },\n\t\t\t{ id: 'dashboard-reports', title: 'Reports' },\n\t\t],\n\t},\n\t{\n\t\tid: 'product',\n\t\ttitle: 'Product',\n\t\ticon: 'lucidePackage',\n\t\titems: [\n\t\t\t{ id: 'product-all', title: 'All products' },\n\t\t\t{ id: 'product-categories', title: 'Categories' },\n\t\t\t{ id: 'product-inventory', title: 'Inventory' },\n\t\t],\n\t},\n\t{\n\t\tid: 'customer',\n\t\ttitle: 'Customer',\n\t\ticon: 'lucideUsers',\n\t\titems: [\n\t\t\t{ id: 'customer-all', title: 'All customers' },\n\t\t\t{ id: 'customer-segments', title: 'Segments' },\n\t\t\t{ id: 'customer-reviews', title: 'Reviews' },\n\t\t],\n\t},\n\t{\n\t\tid: 'shop',\n\t\ttitle: 'Shop',\n\t\ticon: 'lucideStore',\n\t\titems: [\n\t\t\t{ id: 'shop-orders', title: 'Orders' },\n\t\t\t{ id: 'shop-storefront', title: 'Storefront' },\n\t\t\t{ id: 'shop-locations', title: 'Locations' },\n\t\t],\n\t},\n\t{\n\t\tid: 'income',\n\t\ttitle: 'Income',\n\t\ticon: 'lucideCircleDollarSign',\n\t\titems: [\n\t\t\t{ id: 'income-revenue', title: 'Revenue' },\n\t\t\t{ id: 'income-transactions', title: 'Transactions' },\n\t\t\t{ id: 'income-payouts', title: 'Payouts' },\n\t\t],\n\t},\n\t{\n\t\tid: 'promote',\n\t\ttitle: 'Promote',\n\t\ticon: 'lucideMegaphone',\n\t\titems: [\n\t\t\t{ id: 'promote-campaigns', title: 'Campaigns' },\n\t\t\t{ id: 'promote-discounts', title: 'Discounts' },\n\t\t\t{ id: 'promote-audience', title: 'Audience' },\n\t\t],\n\t},\n] as const;\n\nconst ACCOUNTS = [\n\t{\n\t\tname: 'Mathilde Lewis',\n\t\tinitials: 'ML',\n\t\temail: 'mathilde.lewis@simui.com',\n\t\tavatar: 'assets/avatars/mathilde-lewis.png',\n\t},\n\t{\n\t\tname: 'Olivia Rhye',\n\t\tinitials: 'OR',\n\t\temail: 'olivia.rhye@simui.com',\n\t\tavatar: 'assets/avatars/olivia-rhye.jpg',\n\t},\n] as const;\n\n@Component({\n\tselector: 'sim-sidebar-08',\n\timports: [\n\t\tNgIcon,\n\t\tRouterLink,\n\t\tFormsModule,\n\t\tNgScrollbar,\n\t\tHlmKbdImports,\n\t\tHlmButtonImports,\n\t\tHlmCollapsibleImports,\n\t\tHlmAvatarImports,\n\t\tHlmSidebarImports,\n\t\tHlmInputGroupImports,\n\t\tHlmLabelImports,\n\t\tHlmRadioGroupImports,\n\t\tHlmDropdownMenuImports,\n\t\tHlmScrollAreaImports,\n\t],\n\tproviders: [\n\t\tHlmSidebarService,\n\t\tprovideHlmSidebarConfig({ sidebarCookieName: 'sidebar_08_state', sidebarWidth: '13rem' }),\n\t\tprovideIcons({\n\t\t\tlucideSearch,\n\t\t\tlucideChartColumnBig,\n\t\t\tlucideChevronRight,\n\t\t\tlucideCircleDollarSign,\n\t\t\tlucideMegaphone,\n\t\t\tlucidePackage,\n\t\t\tlucideStore,\n\t\t\tlucideUsers,\n\t\t\tlucideSettings,\n\t\t\tlucideExternalLink,\n\t\t\tlucideUser,\n\t\t\tlucideBookOpen,\n\t\t\tlucideLogOut,\n\t\t\tlucidePlus,\n\t\t\tlucideBell,\n\t\t\tlucideMoon,\n\t\t\tlucideSun,\n\t\t\tlucideMessageCircle,\n\t\t}),\n\t],\n\tchangeDetection: ChangeDetectionStrategy.OnPush,\n\tstyles: [\n\t\t`\n\t\t\t:host {\n\t\t\t\t--custom-background: #f1f1f1;\n\n\t\t\t\t--sidebar: oklch(1 0 0);\n\t\t\t\t--sidebar-foreground: oklch(0.145 0 0);\n\t\t\t\t--sidebar-primary: oklch(0.205 0 0);\n\t\t\t\t--sidebar-primary-foreground: oklch(0.985 0 0);\n\t\t\t\t--sidebar-accent: oklch(0.97 0 0);\n\t\t\t\t--sidebar-accent-foreground: oklch(0.205 0 0);\n\t\t\t\t--sidebar-border: oklch(0.922 0 0);\n\t\t\t\t--sidebar-ring: oklch(0.708 0 0);\n\t\t\t}\n\n\t\t\t:host-context(.dark) {\n\t\t\t\t--custom-background: #5a5e61;\n\n\t\t\t\t--sidebar: oklch(0.145 0 0);\n\t\t\t\t--sidebar-foreground: oklch(0.985 0 0);\n\t\t\t\t--sidebar-primary: oklch(0.985 0 0);\n\t\t\t\t--sidebar-primary-foreground: oklch(0.205 0 0);\n\t\t\t\t--sidebar-accent: oklch(0.269 0 0);\n\t\t\t\t--sidebar-accent-foreground: oklch(0.985 0 0);\n\t\t\t\t--sidebar-border: oklch(1 0 0 / 10%);\n\t\t\t\t--sidebar-ring: oklch(0.439 0 0);\n\t\t\t}\n\t\t`,\n\t],\n\ttemplate: `\n\t\t<div hlmSidebarWrapper>\n\t\t\t<hlm-sidebar\n\t\t\t\tcollapsible=\"icon\"\n\t\t\t\tvariant=\"floating\"\n\t\t\t\tclass=\"bg-(--custom-background) *:data-[slot='sidebar-container']:border-none *:data-[slot='sidebar-container']:py-3 *:data-[slot='sidebar-container']:pr-0 *:data-[slot='sidebar-container']:pl-3 **:data-[slot=sidebar-inner]:rounded-4xl!\">\n\t\t\t\t<hlm-sidebar-header>\n\t\t\t\t\t<ul hlmSidebarMenu>\n\t\t\t\t\t\t<li hlmSidebarMenuItem>\n\t\t\t\t\t\t\t<div class=\"flex gap-2 p-2\">\n\t\t\t\t\t\t\t\t<img src=\"assets/logos/logo-square.svg\" alt=\"SimUI\" class=\"size-10 rounded-md\" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</hlm-sidebar-header>\n\t\t\t\t<hlm-sidebar-content>\n\t\t\t\t\t<hlm-sidebar-group class=\"pl-5\">\n\t\t\t\t\t\t<ul hlmSidebarMenu>\n\t\t\t\t\t\t\t@for (item of sidebarItems; track item.id) {\n\t\t\t\t\t\t\t\t<li\n\t\t\t\t\t\t\t\t\thlmSidebarMenuItem\n\t\t\t\t\t\t\t\t\thlmCollapsible\n\t\t\t\t\t\t\t\t\tclass=\"group/collapsible\"\n\t\t\t\t\t\t\t\t\t[expanded]=\"expandedItem() === item.id\"\n\t\t\t\t\t\t\t\t\t(expandedChange)=\"setExpandedItem(item.id, $event)\">\n\t\t\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\t\t\thlmSidebarMenuButton\n\t\t\t\t\t\t\t\t\t\thlmCollapsibleTrigger\n\t\t\t\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\t\t\t\t[isActive]=\"activeItem() === item.id\"\n\t\t\t\t\t\t\t\t\t\t(click)=\"activeItem.set(item.id)\">\n\t\t\t\t\t\t\t\t\t\t<ng-icon [name]=\"item.icon\" class=\"text-muted-foreground!\" />\n\t\t\t\t\t\t\t\t\t\t<span>{{ item.title }}</span>\n\t\t\t\t\t\t\t\t\t\t<ng-icon\n\t\t\t\t\t\t\t\t\t\t\tname=\"lucideChevronRight\"\n\t\t\t\t\t\t\t\t\t\t\tclass=\"ml-auto transition-transform duration-200 group-data-[collapsible=icon]:hidden group-data-[state=open]/collapsible:rotate-90 motion-reduce:transition-none\" />\n\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t<ul hlmSidebarMenuSub hlmCollapsibleContent>\n\t\t\t\t\t\t\t\t\t\t@for (subItem of item.items; track subItem.id) {\n\t\t\t\t\t\t\t\t\t\t\t<li hlmSidebarMenuSubItem class=\"relative\">\n\t\t\t\t\t\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\t\t\t\t\t\thlmSidebarMenuSubButton\n\t\t\t\t\t\t\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"data-active:bg-sidebar-accent! w-full\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[isActive]=\"activeItem() === subItem.id\"\n\t\t\t\t\t\t\t\t\t\t\t\t\t(click)=\"activeItem.set(subItem.id)\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span>{{ subItem.title }}</span>\n\t\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t\t\t\t\t\t\tclass=\"border-sidebar-border absolute top-0 -left-[11px] h-3.5 w-2.5 rounded-bl-lg border border-t-0 border-r-0\"></div>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</hlm-sidebar-group>\n\t\t\t\t</hlm-sidebar-content>\n\n\t\t\t\t<hlm-sidebar-footer>\n\t\t\t\t\t<ul hlmSidebarMenu>\n\t\t\t\t\t\t<li hlmSidebarMenuItem class=\"mb-1 flex justify-start pl-2\">\n\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\thlmBtn\n\t\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\t\tsize=\"icon-lg\"\n\t\t\t\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t\t\t\t\tclass=\"rounded-full\"\n\t\t\t\t\t\t\t\taria-label=\"Open support chat\">\n\t\t\t\t\t\t\t\t<ng-icon name=\"lucideMessageCircle\" />\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li hlmSidebarMenuItem class=\"flex justify-start pb-2 pl-2\">\n\t\t\t\t\t\t\t<div class=\"bg-muted inline-flex h-18 w-10 rounded-full p-1 shadow-sm\">\n\t\t\t\t\t\t\t\t<hlm-radio-group\n\t\t\t\t\t\t\t\t\taria-label=\"Theme\"\n\t\t\t\t\t\t\t\t\tclass=\"group after:bg-background relative grid h-full w-full grid-rows-2 gap-0 after:absolute after:inset-x-0 after:h-1/2 after:rounded-full after:shadow-sm after:transition-[translate,box-shadow] after:duration-300 after:ease-[cubic-bezier(0.16,1,0.3,1)] data-[state=dark]:after:translate-y-0 data-[state=light]:after:translate-y-full after:motion-reduce:transition-none\"\n\t\t\t\t\t\t\t\t\t[attr.data-state]=\"theme()\"\n\t\t\t\t\t\t\t\t\t[ngModel]=\"theme()\"\n\t\t\t\t\t\t\t\t\t(ngModelChange)=\"theme.set($event)\">\n\t\t\t\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t\t\t\tfor=\"sidebar-08-dark-theme\"\n\t\t\t\t\t\t\t\t\t\tclass=\"has-data-[checked=false]:text-muted-foreground has-[.cdk-keyboard-focused]:ring-ring z-10 flex cursor-pointer items-center justify-center rounded-full has-[.cdk-keyboard-focused]:ring-2\">\n\t\t\t\t\t\t\t\t\t\t<ng-icon name=\"lucideMoon\" class=\"text-xl\" />\n\t\t\t\t\t\t\t\t\t\t<hlm-radio\n\t\t\t\t\t\t\t\t\t\t\tvalue=\"dark\"\n\t\t\t\t\t\t\t\t\t\t\tinputId=\"sidebar-08-dark-theme\"\n\t\t\t\t\t\t\t\t\t\t\taria-label=\"Use dark theme\"\n\t\t\t\t\t\t\t\t\t\t\tclass=\"sr-only\" />\n\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t<label\n\t\t\t\t\t\t\t\t\t\tfor=\"sidebar-08-light-theme\"\n\t\t\t\t\t\t\t\t\t\tclass=\"has-data-[checked=false]:text-muted-foreground has-[.cdk-keyboard-focused]:ring-ring z-10 flex cursor-pointer items-center justify-center rounded-full has-[.cdk-keyboard-focused]:ring-2\">\n\t\t\t\t\t\t\t\t\t\t<ng-icon name=\"lucideSun\" class=\"text-xl\" />\n\t\t\t\t\t\t\t\t\t\t<hlm-radio\n\t\t\t\t\t\t\t\t\t\t\tvalue=\"light\"\n\t\t\t\t\t\t\t\t\t\t\tinputId=\"sidebar-08-light-theme\"\n\t\t\t\t\t\t\t\t\t\t\taria-label=\"Use light theme\"\n\t\t\t\t\t\t\t\t\t\t\tclass=\"sr-only\" />\n\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t</hlm-radio-group>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</hlm-sidebar-footer>\n\t\t\t</hlm-sidebar>\n\t\t\t<main\n\t\t\t\thlmSidebarInset\n\t\t\t\tclass=\"grid h-full min-h-0 grid-cols-1 overflow-hidden bg-(--custom-background) pl-3 md:grid-cols-[7fr_3fr]\">\n\t\t\t\t<div class=\"grid max-h-svh min-h-0 grid-rows-1\">\n\t\t\t\t\t<ng-scrollbar hlm class=\"rounded-none\">\n\t\t\t\t\t\t<header class=\"bg-sidebar sticky top-3 mt-3 flex justify-between rounded-full border p-2 shadow-sm\">\n\t\t\t\t\t\t\t<div class=\"flex gap-2 md:hidden\">\n\t\t\t\t\t\t\t\t<button hlmSidebarTrigger type=\"button\" variant=\"outline\" size=\"icon\" class=\"rounded-full\">\n\t\t\t\t\t\t\t\t\t<span class=\"sr-only\">Toggle sidebar</span>\n\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t<button\n\t\t\t\t\t\t\t\t\thlmBtn\n\t\t\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t\t\t\t\t\tsize=\"icon\"\n\t\t\t\t\t\t\t\t\tclass=\"rounded-full\"\n\t\t\t\t\t\t\t\t\taria-label=\"Search\">\n\t\t\t\t\t\t\t\t\t<ng-icon name=\"lucideSearch\" />\n\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<hlm-input-group class=\"bg-background max-w-60 rounded-full max-md:hidden\">\n\t\t\t\t\t\t\t\t<inpu